<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/collapsedBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#CC0F172A"
        android:padding="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/txtFloatingFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IBIS | FPS: --"
            android:textColor="#38BDF8"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/expandedPanel"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E60F172A"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="IBISHUD - REDMI 13"
                android:textColor="#38BDF8"
                android:textStyle="bold"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ _ ]"
                android:textColor="#F8FAFC" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensi Base: Geral 188 | Red Dot 175 | 2x 164 | 4x 152"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DPI Sugerida (Sistema): 510 dp"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />

        <Switch
            android:id="@+id/swEspLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESP Linha (Demo UI)"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />

        <Switch
            android:id="@+id/swEspBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESP Caixa (Demo UI)"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</FrameLayout>
